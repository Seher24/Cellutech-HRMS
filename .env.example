# Neon / Postgres pooled connection (app runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Direct (non-pooling) connection for Prisma migrate
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js — required on Vercel (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_TRUST_HOST="true"

# Local:
NEXTAUTH_URL="http://localhost:3000"
# Vercel production also set:
# AUTH_URL="https://cellutech-hrms.vercel.app"
# NEXTAUTH_URL="https://cellutech-hrms.vercel.app"
